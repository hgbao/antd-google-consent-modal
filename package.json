{
  "name": "antd-google-consent-modal",
  "version": "0.1.0",
  "description": "A consent modal for Google Ads and Google Analytics, built with Ant Design.",
  "main": "dist/index.cjs",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hgbao/antd-google-consent-modal.git"
  },
  "keywords": [
    "antd",
    "google",
    "consent",
    "google-ads"
  ],
  "author": "Bao Huynh",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/hgbao/antd-google-consent-modal#readme",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "depcheck": "depcheck ."
  },
  "peerDependencies": {
    "antd": "^5.21.0 || ^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint",
    "*": "prettier --check --ignore-unknown"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.7.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
